{
  "name": "relay-district",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15 <25" },
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "start": "node packages/server/src/index.ts",
    "build": "tsc --noEmit && vite build --config packages/web/vite.config.ts",
    "test": "node --test tests/*.test.ts",
    "assets": "node scripts/audio.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.37.1",
    "@babylonjs/loaders": "9.37.1",
    "@colyseus/sdk": "^0.18.0",
    "@colyseus/core": "0.18.29",
    "@colyseus/schema": "^5.0.8",
    "@colyseus/ws-transport": "0.18.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.8"
  }
}
